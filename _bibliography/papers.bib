@article{quanh2026lexicographic,
  abbr = {CMC},
  bibtex_show = {true},
  selected = {true},
  title = {Lexicographic Energy-Efficient Scheduling in Semiconductor Assembly and Test Hybrid Flow Shops},
  author = {Quanh, Vo Thi Hoang and Phuc, Phan Nguyen Ky and Hanh, Nguyen Thi My},
  journal = cmc,
  publisher = {Tech Science Press},
  year = {2026},
  doi = {10.32604/cmc.2026.088630},
  html = {https://doi.org/10.32604/cmc.2026.088630},
  code = {https://github.com/vthquanh/lexicographic-energy-efficient-hfs-scheduling},
  abstract = {We study energy-efficient scheduling in semiconductor assembly and test hybrid flow shops. A four-stage mixed-integer linear programming (MILP) model integrates job sequencing, machine assignment, burn-in batching and tester speed selection under a lexicographic tardiness–energy objective. To solve realistic instances, we develop an Extended Teachers' Teaching-Learning-Based Optimization (E-TTLBO) algorithm with a feasibility-preserving batch-packing decoder. E-TTLBO achieves at least 80\% lexicographic win rates in 17 of 18 configurations against a lexicographic genetic algorithm and in 16 of 18 against simulated annealing, reducing energy consumption by 8.8–21.7\% without increasing tardiness.}
}

@article{dat2026green,
  abbr = {IM},
  bibtex_show = {true},
  selected = {true},
  title = {How Does Green Perceived Value Drive Green Purchase Intention? The Parallel Mediating Roles of Green Trust and Customer Engagement},
  author = {Dat, Nguyen Van and Duong, Pham Ngoc and Quanh, Vo Thi Hoang},
  journal = {Innovative Marketing},
  volume = {22},
  number = {3},
  pages = {335--353},
  year = {2026},
  month = sep,
  doi = {10.21511/im.22(3).2026.21},
  html = {https://doi.org/10.21511/im.22(3).2026.21},
  abstract = {Vietnam's green consumption transition is accelerating under national policy pressure, yet actual purchasing behavior remains constrained by psychological barriers that price-focused explanations cannot resolve. This study examines how green perceived value and electronic word of mouth (eWOM) receptivity shape green product purchase intention through the mediating roles of green trust and customer engagement. Data from an online survey of 324 consumers in Ho Chi Minh City were analyzed using Structural Equation Modeling. Green trust was the strongest direct driver of purchase intention, followed by customer engagement, and green perceived value influenced intention exclusively through these two indirect pathways, confirming full mediation.}
}

@article{vy2025innovation,
  abbr = {MSJ},
  bibtex_show = {true},
  title = {Comparative Analysis and Framework Development for Global Innovation Ecosystems: Insights from the Bay Area, Europe and China},
  author = {Vy, Le Nguyen Hoang Yen and Thanh, Pham Thi Linh and Quanh, Vo Thi Hoang},
  journal = {Multidisciplinary Science Journal},
  volume = {8},
  number = {4},
  pages = {2026236},
  year = {2025},
  doi = {10.31893/multiscience.2026236},
  html = {https://doi.org/10.31893/multiscience.2026236},
  abstract = {Innovation ecosystems are critical engines of economic growth. This study develops a structured framework composed of three core dimensions — innovation actors, resources, and environment — and applies it to a comparative analysis of innovation ecosystems in the Bay Area (United States), Europe, and China, drawing on Schumpeter's theory of creative destruction, Freeman's systemic innovation theory, and the Triple/Quadruple Helix models. The findings offer tailored strategic recommendations for developed and developing countries.}
}

